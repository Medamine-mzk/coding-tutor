# LLM keys — all server-side only, never to browser. Client calls /api/tutor/chat and /api/exercise/parse
# At least one is needed for dynamic parsing/tutor; otherwise heuristics run offline.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Model names — stronger for parsing, faster for chat (per PROJECT_SPEC.md:11)
# Groq example: llama-3.1-8b-instant, llama-3.1-70b-versatile
# Gemini example: gemini-2.0-flash, gemini-1.5-flash
TUTOR_MODEL=llama-3.1-8b-instant
PARSE_MODEL=llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash

# Optional: Prisma database url (SQLite dev, Postgres prod via Supabase)
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/mchi_nekteb?schema=public"
