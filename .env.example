# LLM keys — all server-side only, never to browser. Client calls /api/tutor/chat and /api/exercise/parse
# At least one is needed for dynamic parsing/tutor; otherwise heuristics run offline.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Model names — stronger for parsing, faster for chat (per PROJECT_SPEC.md:11)
# Groq example: qwen/qwen3.8-27b (verified working 2026), openai/gpt-oss-20b, allam-2-7b
# Gemini example: gemini-2.0-flash, gemini-1.5-flash
TUTOR_MODEL=qwen/qwen3.8-27b
PARSE_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-2.0-flash

# Teacher auth: HMAC secret for stateless magic-link + session tokens (REQUIRED in
# production — login fails closed without it). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TEACHER_AUTH_SECRET=change-me-min-16-chars

# Optional: Prisma database url (SQLite dev, Postgres prod via Supabase)
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/pymentor?schema=public"
